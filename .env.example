# Copy to .env for a local build that pulls private content.
# Shell variables win over this file. Never commit a filled-in .env.
# Leave SITE_DATA_REPO unset to build the fictional sample site.

SITE_DATA_REPO=manojkumbhar/manojkumbhar-site-data
SITE_DATA_TOKEN=
SITE_DATA_REF=main

# Optional local folder with site.json. Ignored when SITE_DATA_REPO is set.
# SITE_DATA_DIR=
